
"""Task 5 check -- macro-cluster reassignment, with and without outlier removal.

    python experiments/task5_overlap_check.py

Scores three grids against the ground truth: the Task 1 baseline, the raw
macro-cluster grid, and the macro-cluster grid after IsolationForest
outlier removal.

CAVEAT: the same rule-mismatch warning as task4_overlap_check.py applies to
the baseline column -- <slide>_scar_prediction.npy is now built by the
percentile-threshold rule, not the argmax rule Task 5 was compared against.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))   # repo root, for config/metrics

import pandas as pd                                            # noqa: E402

import config                                                  # noqa: E402
from config import SCAR_PREDICTION_DIR, SLIDE_NAMES as SLIDE_IDS    # noqa: E402
from metrics import score_grid, pool_counts, rate_metrics      # noqa: E402

METRIC_NAMES = ["sensitivity", "specificity", "precision", "IoU", "Dice", "accuracy"]

OUTPUT_DIR = config.OUTPUT_DIR / "experiments"


def pool(counts_list):
    return pool_counts(counts_list)


def pooled_metrics(counts):
    return rate_metrics(counts["TP"], counts["FP"], counts["FN"], counts["TN"])


def main():
    config.ensure_dirs(OUTPUT_DIR)
    rows = []
    pooled = {"baseline": [], "task5_raw": [], "task5": []}

    for slide_id in SLIDE_IDS:
        baseline_path = SCAR_PREDICTION_DIR / f"{slide_id}_scar_prediction.npy"
        raw_path = SCAR_PREDICTION_DIR / f"{slide_id}_scar_prediction_task5_raw.npy"
        after_path = SCAR_PREDICTION_DIR / f"{slide_id}_scar_prediction_task5.npy"

        if not (raw_path.exists() and after_path.exists()):
            print(f"{slide_id}: missing Task 5 scar prediction file(s), skipping")
            continue

        raw = score_grid(slide_id, raw_path)
        after = score_grid(slide_id, after_path)
        pooled["task5_raw"].append(raw)
        pooled["task5"].append(after)

        have_baseline = baseline_path.exists()
        baseline = score_grid(slide_id, baseline_path) if have_baseline else None
        if have_baseline:
            pooled["baseline"].append(baseline)

        row = {"slide_id": slide_id}
        for metric in METRIC_NAMES:
            if have_baseline:
                row[f"{metric}_baseline"] = baseline[metric]
            row[f"{metric}_task5_raw"] = raw[metric]
            row[f"{metric}_task5"] = after[metric]
            row[f"{metric}_delta_outliers"] = after[metric] - raw[metric]
        row["removed_TP_by_outliers"] = raw["TP"] - after["TP"]
        row["removed_FP_by_outliers"] = raw["FP"] - after["FP"]
        rows.append(row)

        print(f"\n{slide_id}")
        if have_baseline:
            print(f"  Task 1 baseline:  sens {baseline['sensitivity']:.3f}  "
                  f"prec {baseline['precision']:.3f}  IoU {baseline['IoU']:.3f}")
        print(f"  Task 5 raw:       sens {raw['sensitivity']:.3f}  "
              f"prec {raw['precision']:.3f}  IoU {raw['IoU']:.3f}")
        print(f"  Task 5 (outliers removed): sens {after['sensitivity']:.3f}  "
              f"prec {after['precision']:.3f}  IoU {after['IoU']:.3f}")
        print(f"  TP lost to outlier removal: {raw['TP']-after['TP']}   "
              f"FP lost to outlier removal: {raw['FP']-after['FP']}")

    if not rows:
        print("No slides scored -- check that Task 5 scar prediction files exist.")
        return

    print(f"\n{'='*70}")
    print("POOLED (all slides):")
    for label in ["baseline", "task5_raw", "task5"]:
        if not pooled[label]:
            continue
        pm = pooled_metrics(pool(pooled[label]))
        print(f"\n  [{label}]")
        for metric in METRIC_NAMES:
            print(f"    {metric:<12} {pm[metric]:.3f}")

    if pooled["task5_raw"] and pooled["task5"]:
        raw_counts = pool(pooled["task5_raw"])
        after_counts = pool(pooled["task5"])
        print(f"\n  TP lost to macro-outlier removal (pooled): {raw_counts['TP']-after_counts['TP']}")
        print(f"  FP lost to macro-outlier removal (pooled): {raw_counts['FP']-after_counts['FP']}")

    df = pd.DataFrame(rows)
    csv_path = OUTPUT_DIR / "task5_overlap_comparison.csv"
    df.to_csv(csv_path, index=False)
    print(f"\nSaved: {csv_path}")


if __name__ == "__main__":
    main()



"""Task 5 -- reclassify with the four macro centroids, then prune outliers.

    python experiments/task5_outlier_macroclusters.py

Assigns each candidate tile to its nearest of the four macro centroids
(artefact / normal / scar / peri), keeps the scar one, then removes
IsolationForest outliers. Also computes a per-tile margin -- the gap
between the nearest and second-nearest centroid -- to test whether the
"outliers" are really just tiles sitting on a class boundary.

Exploratory: writes <slide>_scar_prediction_task5_raw.npy (before pruning),
<slide>_scar_prediction_task5.npy (after) and <slide>_task5_scar_margin.npy.
Score with task5_overlap_check.py, and read that script's caveat first.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))   # repo root, for config/metrics

import shutil                                                # noqa: E402
from datetime import datetime                                  # noqa: E402
from collections import defaultdict                            # noqa: E402

import numpy as np                                             # noqa: E402
import matplotlib.pyplot as plt                                # noqa: E402
from matplotlib.colors import ListedColormap                   # noqa: E402
from sklearn.ensemble import IsolationForest                   # noqa: E402

import config                                                  # noqa: E402
from config import (                                           # noqa: E402
    MODEL_OUTPUT_DIR,
    SCAR_CENTRES_4_PATH,
    SCAR_CLASS_INDEX,       # head_arr channel, unrelated to cluster indices
    SLIDE_NAMES,
    VALID_CLUSTER_INDICES as VALID_CLUSTER_INDICES_TASK1,
)

CONFIRMED_SCAR_INDEX = 2   # scar_centres_4 row order: 2 = scar, 3 = peri
CANDIDATE_POOL = "scar_only"   # "all_tissue" or "scar_only" -- see ASSUMPTION note above.
                                # Switched to "scar_only" after the first "all_tissue" run
                                # showed specificity collapse (0.953 -> 0.147) -- that run
                                # was reclassifying ALL tissue via scar_centres_4, pulling in
                                # huge numbers of norm/peri tiles from the overlap zone (see
                                # PCA plot). "scar_only" restricts macro reassignment to
                                # Task 1's existing scar-candidate population, isolating the
                                # effect of scar_centres_4 + outlier removal from the effect
                                # of redefining the candidate pool itself.

CONTAMINATION = "auto"
RANDOM_STATE = 0

OUTPUT_DIR = config.SCAR_PREDICTION_DIR
BACKUP_ROOT = OUTPUT_DIR / "scar_prediction_backups"

# 0=not scar, 1=kept (confirmed scar, inlier), 7=removed as outlier
COLOURS = ["black", "limegreen", "khaki", "khaki", "khaki", "khaki", "khaki", "red"]
CMAP = ListedColormap(COLOURS)


def backup_existing_outputs():
    existing = list(OUTPUT_DIR.glob("*_scar_prediction_task5*.npy")) + \
               list(OUTPUT_DIR.glob("*_scar_prediction_task5_preview.png"))
    if not existing:
        print("No existing Task 5 scar prediction outputs found to back up (first run).")
        return
    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    backup_dir = BACKUP_ROOT / f"task5_{stamp}"
    backup_dir.mkdir(parents=True, exist_ok=True)
    for f in existing:
        shutil.copy2(f, backup_dir / f.name)
    print(f"Backed up {len(existing)} existing file(s) to: {backup_dir}")


def compute_task1_baseline(slide_name, scar_centres_5):
    head_arr = np.load(MODEL_OUTPUT_DIR / f"{slide_name}_scar_head_arr.npy")
    norm_arr = np.load(MODEL_OUTPUT_DIR / f"{slide_name}_scar_norm_arr.npy")
    has_tissue = np.any(head_arr != 0, axis=2)
    predicted_class = np.argmax(head_arr, axis=2)
    is_scar_candidate = (predicted_class == SCAR_CLASS_INDEX) & has_tissue
    scar_idx = np.argwhere(is_scar_candidate)
    scar_prediction = np.zeros(head_arr.shape[:2], dtype=np.int32)
    if len(scar_idx) == 0:
        return scar_prediction
    embeddings = norm_arr[scar_idx[:, 0], scar_idx[:, 1], :]
    dist = np.linalg.norm(embeddings[:, None, :] - scar_centres_5[None, :, :], axis=2)
    nearest = np.argmin(dist, axis=1)
    is_scar = np.isin(nearest, list(VALID_CLUSTER_INDICES_TASK1))
    scar_prediction[scar_idx[is_scar, 0], scar_idx[is_scar, 1]] = nearest[is_scar] + 1
    return scar_prediction


def assign_macro_clusters(slide_name, scar_centres_4):
    """Assigns every tile in CANDIDATE_POOL to its nearest of the 4 macro
    centroids. Returns (idx, macro_label, embeddings, margin, shape).

    margin = distance to 2nd-nearest centroid minus distance to nearest
    centroid. Small margin = tile sits near a class boundary (ambiguous,
    per the PCA overlap seen between norm/peri/scar); large margin =
    confidently assigned. This is independent of IsolationForest and
    lets us check whether "outliers" are really just boundary tiles."""
    head_arr = np.load(MODEL_OUTPUT_DIR / f"{slide_name}_scar_head_arr.npy")
    norm_arr = np.load(MODEL_OUTPUT_DIR / f"{slide_name}_scar_norm_arr.npy")
    has_tissue = np.any(head_arr != 0, axis=2)

    if CANDIDATE_POOL == "scar_only":
        predicted_class = np.argmax(head_arr, axis=2)
        pool_mask = (predicted_class == SCAR_CLASS_INDEX) & has_tissue
    else:
        pool_mask = has_tissue

    idx = np.argwhere(pool_mask)
    if len(idx) == 0:
        return idx, np.array([]), np.array([]), np.array([]), head_arr.shape[:2]

    embeddings = norm_arr[idx[:, 0], idx[:, 1], :]
    dist = np.linalg.norm(embeddings[:, None, :] - scar_centres_4[None, :, :], axis=2)
    sorted_dist = np.sort(dist, axis=1)   # ascending: [nearest, 2nd, 3rd, 4th]
    margin = sorted_dist[:, 1] - sorted_dist[:, 0]
    macro_label = np.argmin(dist, axis=1)
    return idx, macro_label, embeddings, margin, head_arr.shape[:2]


def save_preview(prediction_before_scar, prediction_after, valid_mask, slide_name):
    removed = (prediction_before_scar > 0) & (prediction_after == 0)
    display = prediction_after.copy()
    display[removed] = 7

    fig, axes = plt.subplots(1, 2, figsize=(12, 12))
    axes[0].imshow(display, cmap=CMAP, vmin=0, vmax=7, interpolation="nearest")
    axes[0].set_title(f"{slide_name}\nred=removed as outlier (macro cluster 2), green=kept")

    axes[1].imshow(display, cmap=CMAP, vmin=0, vmax=7, interpolation="nearest")
    if valid_mask is not None:
        axes[1].contour(valid_mask, levels=[0.5], colors="white", linewidths=1.5)
    axes[1].set_title(f"{slide_name}\nsame, with valid_mask boundary (white)")

    for ax in axes:
        ax.axis("off")
    fig.tight_layout()
    fig.savefig(OUTPUT_DIR / f"{slide_name}_scar_prediction_task5_preview.png", dpi=150)
    plt.close(fig)


def main():
    config.ensure_dirs(OUTPUT_DIR)
    backup_existing_outputs()

    scar_centres_4 = np.load(SCAR_CENTRES_4_PATH)
    assert scar_centres_4.shape[0] == 4, f"expected 4 rows in {SCAR_CENTRES_4_PATH}"

    print(f"CANDIDATE_POOL = '{CANDIDATE_POOL}'\n")
    print("Pass 1/2: assigning macro-cluster membership per slide (scar_centres_4)...")

    per_slide = {}   # slide -> (idx, macro_label, shape)
    pooled_by_cluster = defaultdict(list)   # macro_idx -> [(slide, r, c, embedding), ...]

    for slide_name in SLIDE_NAMES:
        try:
            idx, macro_label, embeddings, margin, shape = assign_macro_clusters(slide_name, scar_centres_4)
        except FileNotFoundError as e:
            print(f"  {slide_name}: SKIPPED - file not found: {e}")
            continue
        per_slide[slide_name] = (idx, macro_label, margin, shape)
        for i in range(len(idx)):
            pooled_by_cluster[int(macro_label[i])].append(
                (slide_name, int(idx[i, 0]), int(idx[i, 1]), embeddings[i], float(margin[i]))
            )
        counts_str = ", ".join(f"idx{k}:{int(np.sum(macro_label==k))}" for k in range(4))
        print(f"  {slide_name}: {len(idx)} tiles pooled  [{counts_str}]")

    print("\nPass 2/2: fitting IsolationForest per macro-cluster (pooled across all slides)...")
    outlier_flags = defaultdict(set)   # (slide, r, c) -> flagged as outlier
    scar_records_for_margin = None

    for cluster_idx in sorted(pooled_by_cluster.keys()):
        records = pooled_by_cluster[cluster_idx]
        X = np.stack([r[3] for r in records])
        clf = IsolationForest(contamination=CONTAMINATION, random_state=RANDOM_STATE)
        preds = clf.fit_predict(X)
        n_outliers = int(np.sum(preds == -1))
        pct = 100 * n_outliers / len(records)
        tag = " <-- SCAR" if cluster_idx == CONFIRMED_SCAR_INDEX else ""
        print(f"  macro cluster {cluster_idx}: {len(records)} tiles, "
              f"{n_outliers} flagged as outliers ({pct:.1f}%){tag}")
        for (slide_name, r, c, _, _), pred in zip(records, preds):
            if pred == -1:
                outlier_flags[slide_name].add((r, c))
        if cluster_idx == CONFIRMED_SCAR_INDEX:
            scar_records_for_margin = list(zip(records, preds))

    if scar_records_for_margin:
        margins = np.array([rec[4] for rec, _ in scar_records_for_margin])
        is_outlier = np.array([pred == -1 for _, pred in scar_records_for_margin])

        print(f"\nMargin diagnostic (scar macro-cluster, n={len(margins)} tiles):")
        print(f"  margin: mean={margins.mean():.3f}  median={np.median(margins):.3f}  "
              f"p10={np.percentile(margins,10):.3f}  p25={np.percentile(margins,25):.3f}")

        low_margin_cutoff = np.percentile(margins, 15)
        is_low_margin = margins <= low_margin_cutoff
        n_low_margin = int(is_low_margin.sum())
        n_outlier = int(is_outlier.sum())
        n_overlap = int((is_low_margin & is_outlier).sum())
        overlap_pct_of_outliers = 100 * n_overlap / n_outlier if n_outlier else float("nan")
        overlap_pct_of_low_margin = 100 * n_overlap / n_low_margin if n_low_margin else float("nan")

        print(f"  bottom-15%-margin (ambiguous/near-boundary) tiles: {n_low_margin}")
        print(f"  IsolationForest-flagged outlier tiles: {n_outlier}")
        print(f"  overlap: {n_overlap} tiles are BOTH low-margin AND IsolationForest outliers")
        print(f"    -> {overlap_pct_of_outliers:.1f}% of IsolationForest's flagged outliers are "
              f"also bottom-15%-margin boundary tiles")
        print(f"    -> {overlap_pct_of_low_margin:.1f}% of bottom-15%-margin tiles were "
              f"also flagged by IsolationForest")
        print("  (high overlap suggests IsolationForest is mostly rediscovering class-boundary")
        print("   tiles rather than finding true embedding-space anomalies)")

        fig, ax = plt.subplots(figsize=(8, 5))
        ax.hist(margins[~is_outlier], bins=60, alpha=0.6, label="kept (inlier)", color="tab:blue")
        ax.hist(margins[is_outlier], bins=60, alpha=0.6, label="removed (IsolationForest outlier)", color="tab:red")
        ax.axvline(low_margin_cutoff, color="black", linestyle="--", linewidth=1,
                   label=f"bottom-15% margin cutoff ({low_margin_cutoff:.2f})")
        ax.set_xlabel("margin (dist to 2nd-nearest centroid − dist to nearest centroid)")
        ax.set_ylabel("tile count")
        ax.set_title("Scar macro-cluster: margin distribution, IsolationForest outliers vs inliers\n"
                     "(pooled across all 6 slides)")
        ax.legend()
        fig.tight_layout()
        hist_path = config.OUTPUT_DIR / "experiments" / "task5_scar_margin_histogram.png"
        config.ensure_dirs(hist_path.parent)
        fig.savefig(hist_path, dpi=150)
        plt.close(fig)
        print(f"  Saved: {hist_path}")

    print("\nBuilding scar predictions (scar macro-cluster only)...")
    summary = []
    for slide_name in SLIDE_NAMES:
        if slide_name not in per_slide:
            summary.append((slide_name, "MISSING FILES", "-", "-"))
            continue

        idx, macro_label, margin, shape = per_slide[slide_name]
        prediction_raw = np.zeros(shape, dtype=np.int32)
        is_scar = macro_label == CONFIRMED_SCAR_INDEX
        prediction_raw[idx[is_scar, 0], idx[is_scar, 1]] = 1

        prediction_after = prediction_raw.copy()
        flags = outlier_flags.get(slide_name, set())
        for (r, c) in flags:
            if prediction_after[r, c] > 0:
                prediction_after[r, c] = 0

        np.save(OUTPUT_DIR / f"{slide_name}_scar_prediction_task5_raw.npy", prediction_raw)
        np.save(OUTPUT_DIR / f"{slide_name}_scar_prediction_task5.npy", prediction_after)

        margin_grid = np.zeros(shape, dtype=np.float32)
        margin_grid[idx[is_scar, 0], idx[is_scar, 1]] = margin[is_scar]
        np.save(OUTPUT_DIR / f"{slide_name}_task5_scar_margin.npy", margin_grid)

        # NOTE: deliberately does NOT write a baseline grid if one is missing --
        # compute_task1_baseline uses the old argmax rule, and writing it to
        # <slide>_scar_prediction.npy would silently replace the pipeline's
        # percentile-threshold output with a different classifier.
        baseline_path = OUTPUT_DIR / f"{slide_name}_scar_prediction.npy"
        if not baseline_path.exists():
            print(f"  {slide_name}: no baseline scar_prediction.npy -- run 02_classify_tiles.py "
                  f"to create one; not writing an argmax-rule grid in its place")

        valid_mask_path = config.valid_mask_path(slide_name)
        valid_mask = np.load(valid_mask_path) if valid_mask_path.exists() else None
        save_preview(prediction_raw, prediction_after, valid_mask, slide_name)

        n_before = int(np.sum(prediction_raw > 0))
        n_after = int(np.sum(prediction_after > 0))
        n_removed = n_before - n_after
        pct_removed = 100 * n_removed / n_before if n_before else 0
        summary.append((slide_name, n_before, n_after, n_removed, f"{pct_removed:.1f}%"))
        print(f"  {slide_name}: {n_before} -> {n_after} scar tiles ({n_removed} removed, {pct_removed:.1f}%)")

    print("\n--- SUMMARY ---")
    print(f"{'slide':<20}{'before':<10}{'after':<10}{'removed':<10}{'% removed'}")
    for row in summary:
        print(f"{row[0]:<20}{str(row[1]):<10}{str(row[2]):<10}{str(row[3]):<10}{row[4] if len(row) > 4 else ''}")

    print("\nDone. Check *_scar_prediction_task5_preview.png and task5_scar_margin_histogram.png.")
    print("*_task5_scar_margin.npy holds per-tile margin (0 outside the scar macro-cluster).")
    print("Next: run task5_overlap_check.py to compare scar_prediction_task5_raw.npy (before) vs")
    print("scar_prediction_task5.npy (after) against GT, and optionally against scar_prediction.npy (Task 1 baseline).")


if __name__ == "__main__":
    main()

