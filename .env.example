# Copy to .env and edit, or export these directly in your shell.
# .env is gitignored and is NOT read automatically -- source it, or set the
# variables in your shell profile / run configuration.

# Everything under one folder (see README.md for the expected layout)
SCAR_PROJECT_DIR=/path/to/data

# Optional per-folder overrides
# SCAR_MODEL_OUTPUT_DIR=/path/to/predictions
# SCAR_GT_DIR=/path/to/ground_truth
# SCAR_PREDICTION_DIR=/path/to/scar_predictions
# SCAR_SLIDE_DIR=/path/to/slides
# SCAR_OUTPUT_DIR=/path/to/outputs
# SCAR_QUPATH_PROJECT=/path/to/project.qpproj
# SCAR_CENTRES_4=/path/to/scar_centres_4.npy
# SCAR_CENTRES_5=/path/to/scar_centres_5.npy

# Run a different set of slides without editing config.py
# SCAR_SLIDE_NAMES=MSW02_09_08_d70,MSW02_10_02_d70

# Native dependencies (only for 01_write_tiles_to_qupath.py,
# 03_extract_ground_truth.py and figure_tissue_panels.py)
# Windows only: the "bin" folder of an OpenSlide binary release
# OPENSLIDE_BIN_DIR=C:\path\to\openslide-bin-x.y.z-windows-x64\bin
# QuPath installation directory, read by paquo
# PAQUO_QUPATH_DIR=C:\path\to\QuPath-v0.7.0-Windows
